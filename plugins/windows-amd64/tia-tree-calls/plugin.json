{
  "$schema": "../../plugin.schema.json",
  "schemaVersion": "1.0",
  "id": "tia-tree-calls",
  "name": "TIA Portal Call Tree",
  "name_cn": "TIA Portal 调用树",
  "description": "Read a block call graph JSON (generated by tia-scan-calls) and render a visual tree of the call hierarchy. Supports filtering by entry block, block type, and depth.",
  "description_cn": "读取块调用关系 JSON（由 tia-scan-calls 生成），以可视化树形结构展示调用层级。支持按入口块、块类型和深度过滤。",
  "version": "1.0.0",
  "author": "CLI Tool Center",
  "icon": "",
  "navigation": {
    "group": ["Industrial Automation", "TIA Portal"],
    "group_cn": ["工业自动化", "TIA Portal"],
    "order": 3
  },
  "form": {
    "schema": "schema.json",
    "uischema": "uischema.json"
  },
  "execution": {
    "target": "tia-tree-calls.ps1",
    "runner": "powershell",
    "parameters": [
      {
        "field": "inputFile",
        "kind": "option",
        "flag": "-InputFile"
      },
      {
        "field": "entry",
        "kind": "option-array",
        "flag": "-Entry",
        "style": "repeat"
      },
      {
        "field": "outputFile",
        "kind": "option",
        "flag": "-OutputFile"
      },
      {
        "field": "type",
        "kind": "option-array",
        "flag": "-Type",
        "style": "repeat"
      },
      {
        "field": "level",
        "kind": "option",
        "flag": "-Level"
      }
    ]
  },
  "output": {
    "type": "text"
  },
  "capabilities": [
    "file-input"
  ]
}
